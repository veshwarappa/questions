    status,
    started_at,
    completed_at,
    error_message
FROM workflow_runs
WHERE desk_id IN (
    '44e3b39a-a46a-4970-b834-d3d72da9f276',
    'f66c1d4d-b3a8-4660-b147-cda58f43fc0b'
