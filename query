select *
from app_users
where lower(full_name) like '%jasmin ee%';

select *
from app_users
where lower(full_name) like '%jasmin%'
   or lower(email) like '%jasmin%';

select *
from meeting_records
where lower(interviewee_email) = lower('<jasmin_email>')
  and created_at::date = '2026-03-19'
order by created_at desc;

select meeting_id,
       processing_state,
       interviewee_email,
       subject,
       created_at,
       completed_at,
       payload_submitted_at,
       processing_duration_seconds
from meeting_records
where created_at::date = '2026-03-19'
  and lower(interviewee_email) like '%jasmin%'
order by created_at desc;

