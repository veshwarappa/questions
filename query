SELECT is_active, desk_id, frequency, owner_name
FROM desk_configurations
WHERE lower(owner_name) LIKE '%sonia%'
   OR lower(owner_name) LIKE '%diestel%'
   OR lower(owner_name) LIKE '%feddersen%'

SELECT
    dc.desk_id,
    dc.desk_name,
    dc.desk_owner,
    dc.is_active,
    dc.frequency,
    max(dr.generated_at) AS last_report_generated_at
FROM desk_configurations dc
LEFT JOIN desk_reports dr
    ON dc.desk_id = dr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.desk_name, dc.desk_owner, dc.is_active, dc.frequency
HAVING max(dr.generated_at) IS NULL
    OR max(dr.generated_at) < '2026-02-23 00:00:00'
ORDER BY last_report_generated_at NULLS FIRST;

SELECT
    dc.desk_id,
    dc.desk_name,
    max(wr.started_at) AS last_workflow_started_at,
    max(wr.completed_at) AS last_workflow_completed_at,
    max(CASE WHEN wr.status = 'completed' THEN wr.started_at END) AS last_completed_workflow_at,
    max(CASE WHEN wr.status = 'failed' THEN wr.started_at END) AS last_failed_workflow_at
FROM desk_configurations dc
LEFT JOIN workflow_runs wr
    ON dc.desk_id = wr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.desk_name
ORDER BY last_workflow_started_at NULLS FIRST;

SELECT
    dc.desk_id,
    dc.desk_name,
    dc.desk_owner,
    dc.frequency
FROM desk_configurations dc
WHERE dc.is_active = true
AND NOT EXISTS (
    SELECT 1
    FROM workflow_runs wr
    WHERE wr.desk_id = dc.desk_id
      AND wr.started_at >= '2026-02-23 00:00:00'
)
ORDER BY dc.desk_name;

SELECT
    dc.desk_id,
    dc.desk_name,
    dc.desk_owner,
    max(wr.started_at) AS last_workflow_at,
    max(dr.generated_at) AS last_report_at
FROM desk_configurations dc
LEFT JOIN workflow_runs wr
    ON dc.desk_id = wr.desk_id
LEFT JOIN desk_reports dr
    ON dc.desk_id = dr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.desk_name, dc.desk_owner
HAVING max(wr.started_at) >= '2026-02-23 00:00:00'
   AND (max(dr.generated_at) IS NULL OR max(dr.generated_at) < max(wr.started_at))
ORDER BY last_workflow_at DESC;

SELECT
    frequency,
    count(*) AS desk_count
FROM desk_configurations
WHERE desk_id IN (
    SELECT dc.desk_id
    FROM desk_configurations dc
    WHERE dc.is_active = true
    AND NOT EXISTS (
        SELECT 1
        FROM workflow_runs wr
        WHERE wr.desk_id = dc.desk_id
          AND wr.started_at >= '2026-02-23 00:00:00'
    )
)
GROUP BY frequency
ORDER BY desk_count DESC;

