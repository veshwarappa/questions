       subject,
       interviewee_email,
       processed,
       created_at,
       last_checked_at,
       retry_count,
       transcript_available_at,
       max_retries
from transcripts
where meeting_id = 'AAMkADRkYmRkMWI2LWIxNTgtNGYyZ105OTUyLTI0YzA2NmVjODkwMwBGAAAAAABa1JyN086eQ6w74hu3abwdBwDsvt7FT2AwRJhN0Bmde0NUAAAAAAENAADsvt7FT2AwRJhN0Bmde0NUAAR8_wV4AAA=';

select meeting_record_id,
       error_type,
       error_category,
       error_code,
       step_name,
       error_message,
       occurred_at
from errors
where meeting_record_id = 'AAMkADRkYmRkMWI2LWIxNTgtNGYyZ105OTUyLTI0YzA2NmVjODkwMwBGAAAAAABa1JyN086eQ6w74hu3abwdBwDsvt7FT2AwRJhN0Bmde0NUAAAAAAENAADsvt7FT2AwRJhN0Bmde0NUAAR8_wV4AAA='
