SELECT is_active, desk_id, frequency, owner_name
FROM desk_configurations
WHERE lower(owner_name) LIKE '%sonia%'
   OR lower(owner_name) LIKE '%diestel%'
   OR lower(owner_name) LIKE '%feddersen%'

ContainerAppSystemLogs_CL
| where TimeGenerated between (datetime(2026-02-20 00:00:00) .. datetime(2026-03-20 00:00:00))
| where ContainerAppName_s == "market-intelligence-backend"
| where Log_s contains "restart"
    or Log_s contains "Started"
    or Log_s contains "Stopping"
    or Log_s contains "Replica"
    or Log_s contains "revision"
| project TimeGenerated, RevisionName_s, Log_s
| order by TimeGenerated asc

ContainerAppSystemLogs_CL
| where TimeGenerated between (datetime(2026-02-20 00:00:00) .. datetime(2026-03-20 00:00:00))
| where ContainerAppName_s == "market-intelligence-backend"
| where Log_s contains "Replica"
| project TimeGenerated, RevisionName_s, ReplicaName_s, Log_s
| order by TimeGenerated asc

ContainerAppSystemLogs_CL
| where TimeGenerated between (datetime(2026-02-22 00:00:00) .. datetime(2026-02-25 00:00:00))
| where ContainerAppName_s == "market-intelligence-backend"
| project TimeGenerated, RevisionName_s, ReplicaName_s, Log_s
| order by TimeGenerated asc

ContainerAppSystemLogs_CL
| where TimeGenerated between (datetime(2026-02-20 00:00:00) .. datetime(2026-03-20 00:00:00))
| where ContainerAppName_s == "market-intelligence-backend"
| where Log_s contains "revision"
    or Log_s contains "deploy"
| project TimeGenerated, RevisionName_s, Log_s
| order by TimeGenerated asc
