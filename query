select
    meeting_id,
    subject,
    processed,
    created_at,
    transcript_available_at,
    last_checked_at,
    retry_count,
    max_retries,
    case
        when transcript is null then 'NULL'
        when length(trim(transcript)) = 0 then 'EMPTY'
        else 'PRESENT'
    end as transcript_status
from transcripts
where meeting_id = '<meeting_id>';

select
    meeting_id,
    processing_state,
    created_at,
    completed_at,
    payload_submitted_at,
    case
        when submitted_payload is null then 'NULL'
        else 'PRESENT'
    end as submitted_payload_status
from meeting_records
where meeting_id = '<meeting_id>';



select
    meeting_record_id,
    step_name,
    step_type,
    status,
    started_at,
    completed_at,
    duration_seconds,
    model,
    provider,
    input_tokens,
    output_tokens,
    total_cost_usd,
    step_metadata
from pipeline_events
where meeting_record_id = '<meeting_id>'
order by started_at asc;
