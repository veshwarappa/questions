| where Log_s contains "f66c1d4d-b3a8-4660-b147-cda58f43fc0b"
    or Log_s contains "1feea30b-5141-4767-a7ee-4ae4c1498fc5"
    or Log_s contains "Sonia.Diestel-Feddersen@hays.com.au"
