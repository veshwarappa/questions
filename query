select
  occurred_at,
  step_name,
  error_type,
  error_category,
  error_code,
  left(error_message, 300) as error_message,
  meeting_record_id,
  pipeline_event_id,
  context
from errors
where occurred_at::date between '2026-02-17' and '2026-02-19'
order by occurred_at desc;

select
  occurred_at,
  step_name,
  error_type,
  error_category,
  error_code,
  left(error_message, 300) as error_message,
  meeting_record_id,
  context
from errors
where lower(coalesce(error_message,'')) like '%kelly%'
   or lower(coalesce(error_message,'')) like '%st vincent%'
   or lower(coalesce(context::text,'')) like '%kelly%'
   or lower(coalesce(context::text,'')) like '%st vincent%'
order by occurred_at desc;

select
  occurred_at,
  step_name,
  error_type,
  error_category,
  error_code,
  left(error_message, 300) as error_message,
  meeting_record_id,
  context
from errors
where lower(coalesce(step_name,'')) like '%transcript%'
   or lower(coalesce(step_name,'')) like '%ingest%'
   or lower(coalesce(step_name,'')) like '%sync%'
   or lower(coalesce(step_name,'')) like '%fetch%'
   or lower(coalesce(error_message,'')) like '%transcript%'
   or lower(coalesce(error_message,'')) like '%onedrive%'
   or lower(coalesce(error_message,'')) like '%teams%'
   or lower(coalesce(error_message,'')) like '%graph%'
order by occurred_at desc;


select
  occurred_at,
  step_name,
  error_code,
  left(error_message, 300) as error_message,
  context
from errors
where lower(coalesce(context::text,'')) like '%rebecca homewood%'
   or lower(coalesce(context::text,'')) like '%kelly daly%'
   or lower(coalesce(context::text,'')) like '%st vincent de paul%'
order by occurred_at desc;
