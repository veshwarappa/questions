SELECT meeting_id, processing_state, created_at, completed_at
FROM meeting_records
WHERE subject ILIKE '%Gregory O''Brien%'
ORDER BY created_at DESC;

SELECT *
FROM transcripts
WHERE meeting_id = '<MEETING_ID>';

SELECT step_name, status, started_at, completed_at
FROM pipeline_events
WHERE meeting_record_id = '<MEETING_ID>'
ORDER BY started_at;

SELECT retry_count, max_retries, last_checked_at
FROM transcripts
WHERE meeting_id = '<MEETING_ID>';

SELECT *
FROM errors
WHERE meeting_id = '<MEETING_ID>'
ORDER BY created_at DESC;
