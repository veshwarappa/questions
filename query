SELECT is_active, desk_id, frequency, owner_name
FROM desk_configurations
WHERE lower(owner_name) LIKE '%sonia%'
   OR lower(owner_name) LIKE '%diestel%'
   OR lower(owner_name) LIKE '%feddersen%'

SELECT
    dc.desk_id,
    dc.name,
    dc.desk_owner,
    dc.is_active,
    dc.frequency,
    max(dr.generated_at) AS last_report_generated_at
FROM desk_configurations dc
LEFT JOIN desk_reports dr
    ON dc.desk_id = dr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.name, dc.desk_owner, dc.is_active, dc.frequency
HAVING max(dr.generated_at) IS NULL
    OR max(dr.generated_at) < '2026-02-23 00:00:00+00'
ORDER BY last_report_generated_at NULLS FIRST, dc.name;

SELECT
    dc.desk_id,
    dc.name,
    dc.desk_owner,
    dc.frequency,
    dc.is_active
FROM desk_configurations dc
WHERE dc.is_active = true
AND NOT EXISTS (
    SELECT 1
    FROM workflow_runs wr
    WHERE wr.desk_id = dc.desk_id
      AND wr.started_at >= '2026-02-23 00:00:00+00'
)
ORDER BY dc.name;


SELECT
    wr.desk_id,
    dc.name,
    dc.desk_owner,
    count(*) AS failed_run_count,
    min(wr.started_at) AS first_failed_at,
    max(wr.started_at) AS last_failed_at,
    max(wr.error_message) AS sample_error
FROM workflow_runs wr
LEFT JOIN desk_configurations dc
    ON wr.desk_id = dc.desk_id
WHERE wr.started_at >= '2026-02-23 00:00:00+00'
  AND wr.status = 'failed'
GROUP BY wr.desk_id, dc.name, dc.desk_owner
ORDER BY failed_run_count DESC, last_failed_at DESC;

SELECT
    dc.desk_id,
    dc.name,
    dc.desk_owner,
    max(wr.started_at) AS last_workflow_at,
    max(dr.generated_at) AS last_report_at
FROM desk_configurations dc
LEFT JOIN workflow_runs wr
    ON dc.desk_id = wr.desk_id
LEFT JOIN desk_reports dr
    ON dc.desk_id = dr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.name, dc.desk_owner
HAVING max(wr.started_at) >= '2026-02-23 00:00:00+00'
   AND (
       max(dr.generated_at) IS NULL
       OR max(dr.generated_at) < '2026-02-23 00:00:00+00'
   )
ORDER BY last_workflow_at DESC NULLS LAST, dc.name;

SELECT
    dc.desk_id,
    dc.name,
    dc.desk_owner,
    dc.frequency,
    max(wr.started_at) AS last_workflow_at,
    max(dr.generated_at) AS last_report_at
FROM desk_configurations dc
LEFT JOIN workflow_runs wr
    ON dc.desk_id = wr.desk_id
LEFT JOIN desk_reports dr
    ON dc.desk_id = dr.desk_id
WHERE dc.is_active = true
GROUP BY dc.desk_id, dc.name, dc.desk_owner, dc.frequency
ORDER BY last_report_at NULLS FIRST, last_workflow_at NULLS FIRST, dc.name;
