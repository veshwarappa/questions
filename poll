<mxfile host="app.diagrams.net">
  <diagram name="AI Agents Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- USERS -->
        <mxCell id="users" value="Hays Users (VPN + Entra ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- M365 -->
        <mxCell id="m365" value="M365 (Teams, Outlook)" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- AZURE BOUNDARY -->
        <mxCell id="azure" value="Azure (APAC VNet)" style="swimlane;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="700" height="500" as="geometry"/>
        </mxCell>

        <!-- CONTAINER APPS -->
        <mxCell id="apps" value="Azure Container Apps&#xa;- Smarter Meetings&#xa;- Market Insights" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="azure">
          <mxGeometry x="60" y="120" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- BACKEND -->
        <mxCell id="backend" value="Backend APIs (FastAPI + LangChain)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="azure">
          <mxGeometry x="60" y="260" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- QUEUE -->
        <mxCell id="queue" value="Azure Storage Queue" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="azure">
          <mxGeometry x="320" y="260" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- DB -->
        <mxCell id="db" value="Azure PostgreSQL" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="azure">
          <mxGeometry x="320" y="340" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- OPENAI -->
        <mxCell id="openai" value="Azure OpenAI" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="azure">
          <mxGeometry x="520" y="260" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- KEYVAULT -->
        <mxCell id="kv" value="Key Vault" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="azure">
          <mxGeometry x="520" y="340" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- OBSERVABILITY -->
        <mxCell id="langfuse" value="Langfuse (VM) + Redis + Clickhouse" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="azure">
          <mxGeometry x="320" y="150" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- EXTERNAL -->
        <mxCell id="onTouch" value="OneTouch APIs (AWS)" style="rounded=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="960" y="200" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="exa" value="Exa AI (Public Internet)" style="rounded=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="960" y="320" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- FLOWS -->
        <mxCell id="f1" style="endArrow=block" edge="1" parent="1" source="users" target="apps"/>
        <mxCell id="f2" style="endArrow=block" edge="1" parent="1" source="m365" target="backend"/>
        <mxCell id="f3" style="endArrow=block" edge="1" parent="1" source="backend" target="queue"/>
        <mxCell id="f4" style="endArrow=block" edge="1" parent="1" source="queue" target="backend"/>
        <mxCell id="f5" style="endArrow=block" edge="1" parent="1" source="backend" target="db"/>
        <mxCell id="f6" style="endArrow=block" edge="1" parent="1" source="backend" target="openai"/>
        <mxCell id="f7" style="endArrow=block" edge="1" parent="1" source="backend" target="kv"/>
        <mxCell id="f8" style="endArrow=block" edge="1" parent="1" source="backend" target="langfuse"/>

        <!-- EXTERNAL FLOWS -->
        <mxCell id="f9" style="endArrow=block;strokeColor=red" edge="1" parent="1" source="backend" target="onTouch"/>
        <mxCell id="f10" style="endArrow=block;strokeColor=green" edge="1" parent="1" source="backend" target="exa"/>

      </root>
    </mxGraphModel>
